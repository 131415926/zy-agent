# ===== 模型平台配置（多平台：改 PROVIDER 即切换）=====
# 可选：sensenova | openai | 任意 OpenAI 兼容端点
LLM_PROVIDER=sensenova

# ---- SenseNova（OpenAI 兼容协议）----
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=
SENSENOVA_MODEL=

# ---- OpenAI 官方（备用）----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---- Embedding（RAG 用，SenseNova 不提供时可换其他平台）----
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING=text-embedding-3-small
